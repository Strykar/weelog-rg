                "[dim]Press ? or Esc to close.[/dim]"
            ))

    def action_dismiss(self) -> None:
        self.app.pop_screen()


class HindsightCommands(Provider):
    """Custom commands for the Ctrl+P palette."""

    async def search(self, query: str):
        commands = self._commands()
        matcher = self.matcher(query)
        for label, callback, help_text in commands:
            score = matcher.match(label)
            if score > 0:
                yield Hit(score, label, callback, help=help_text)

    async def discover(self):
        for label, callback, help_text in self._commands():
            yield Hit(1.0, label, callback, help=help_text)

    def _commands(self) -> list[tuple[str, object, str]]:
        app = self.app

        def _toggle_chip(chip_id: str):
            def go():
                try:
                    cb = app.query_one(f"#{chip_id}", Checkbox)
                    cb.value = not cb.value
                except NoMatches:
                    pass
            return go

        return [
            ("Toggle system buffers", _toggle_chip("q-system"),
             "znc, soju, services, meta"),
            ("Toggle archives", _toggle_chip("q-archives"),
             ".gz / .zst rotated logs"),
            ("Toggle event lines", _toggle_chip("q-events"),
             "join / part / topic"),
            ("Toggle compact view", _toggle_chip("col-compact"),
             "minimal columns"),
            ("Toggle context pane", _toggle_chip("col-context"),
             "preview below results"),
            ("Toggle filter bar", lambda: app.action_toggle_filters(),
             "F2"),
            ("Toggle tree", lambda: app.action_toggle_tree(),
             "F4"),
            ("Export results", lambda: app.action_export(),
             "Ctrl+E"),
            ("Show help", lambda: app.action_help(),
             "?"),
        ]


