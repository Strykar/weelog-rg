                    yield DataTable(id="results", cursor_type="row", zebra_stripes=True)
                with Vertical(id="preview-box"):
                    yield Static(
                        "Context - select a result",
                        id="preview-title", classes="pane-title",
                    )
                    yield RichLog(
                        max_lines=500, wrap=True, markup=True,
                        id="preview-content",
                    )
        yield Footer(show_command_palette=False)

    def on_mount(self) -> None:
        self._apply_theme()
        self._populate_tree()
        self._rebuild_columns()
        self._show_onboarding()
        self._apply_responsive_layout()
        self.query_one("#q-text", Input).focus()
        s = self._stats
        ms = s.get("elapsed_ms", 0)
        if s.get("cache_hit"):
            self.notify(
                f"Cache loaded ({ms} ms)", severity="information", timeout=3,
            )
        else:
            self.notify(
                f"Index built and cached ({ms} ms)", severity="warning", timeout=4,
            )

    def on_resize(self) -> None:
        self._apply_responsive_layout()

    def _apply_responsive_layout(self) -> None:
        """Pick a responsive class on the Screen based on terminal width
        and apply sensible defaults for each breakpoint. Also auto-hides
        heavy panes when the terminal is too cramped to show them well.

        Users can still F3 / F4 to reclaim the context / tree panes on
        narrow screens, and F2 to reclaim the filter bar.
        """
        width = self.size.width or 120
        screen = self.screen
        for cls in ("-narrow", "-wide"):
            screen.remove_class(cls)
        if width < 100:
            screen.add_class("-narrow")
        elif width >= 180:
            screen.add_class("-wide")

        # First-fit auto-hide: if the terminal is very tight, hide
        # panes that would otherwise squeeze out the results column.
        # Does not override a user who has explicitly toggled them.
        # One-shot: only auto-hide panes on the very first layout pass.
        # After that, the user has seen (and possibly toggled) them, so
        # a mid-session resize shouldn't undo their choices.
        if not getattr(self, "_responsive_initialised", False):
            try:
                tree_pane = self.query_one("#tree-pane")
                preview_box = self.query_one("#preview-box")
                ctx_cb = self.query_one("#col-context", Checkbox)
                if width < 70:
                    tree_pane.add_class("hidden")
                    ctx_cb.value = False  # also hides preview_box
                elif width < 100:
                    # Medium-narrow: keep tree, drop context by default
                    ctx_cb.value = False
                # else: show everything
                _ = preview_box  # reference silences unused-var lint
                self._responsive_initialised = True
            except NoMatches:
                # Compose hasn't run yet; on_mount will retry later.
                pass

    def _apply_theme(self) -> None:
        """Resolve theme preference. 'auto' delegates to Textual's own
        dark-mode detection (current_theme.dark) instead of hand-rolling
        COLORFGBG / GTK_THEME parsing."""
        want = self._theme_pref
        if want == "auto":
            want = "dark" if self.current_theme.dark else "light"
        available = set(self.available_themes)
        if want in available:
            self.theme = want
        elif want == "light":
            self.theme = "textual-light" if "textual-light" in available else "solarized-light"
        elif want == "dark":
            self.theme = "textual-dark" if "textual-dark" in available else "monokai"

    def _rebuild_columns(self) -> None:
        with self.batch_update():
            dt = self.query_one("#results", DataTable)
            dt.clear(columns=True)
            headers: list[str] = []
            if self._compact:
                headers += ["time", "where", "message"]
            else:
                headers += ["when", "ago", "where", "who", "message"]
            dt.add_columns(*headers)
            self._render_rows()
            # Hide column headers when there are no results so the
            # idle/empty state doesn't show a bare header row.
            dt.show_header = bool(self._matches)

    def _row_for(self, m: Match) -> list:
        lf = self._by_path.get(m.path)
        buffer = lf.buffer if lf else Path(m.path).stem.split(".")[0]
        network = lf.network if lf else ""
        kind = classify_buffer(network, buffer) if lf else "pm"
        row: list = []

        if self._compact:
            row.append(Text(extract_hms(m.timestamp)))
            row.append(self._where_cell(buffer, kind, m))
        else:
            row.append(Text(m.timestamp))
            row.append(Text(format_relative(m.timestamp), style="dim"))
            row.append(self._where_cell(buffer, kind, m))
            row.append(self._nick_cell(m, kind))

        truncated_msg = len(m.message) > 120
        msg = m.message[:120] + ("\u2026" if truncated_msg else "")
        msg_text = render_message(msg, self._use_osc8)
        if m.is_event:
            msg_text.stylize("dim")
        elif kind == "pm":
            msg_text.stylize("magenta")
        row.append(msg_text)
        return row

    @staticmethod
    def _where_cell(buffer: str, kind: str, m: Match) -> Text:
        # PM is the only kind that gets the directional arrow.
        if kind == "pm":
            incoming = (m.who.casefold() == buffer.casefold())
            arrow = "← " if incoming else "→ "
            t = Text()
            t.append(arrow, style="bold magenta")
            t.append(buffer, style="magenta italic")
            return t
        # Non-conversation kinds get a dim tag prefix so the row reads
        # as "this is a server/monitor/znc/etc. message" rather than
        # masquerading as chat.
        tag_for = {
            "server": "srv",
            "monitor": "mon",
            "user_core": "core",
            "znc": "znc",
            "soju": "soju",
            "service": "svc",
        }
        tag = tag_for.get(kind)
        if tag:
            t = Text()
            t.append(f"[{tag}] ", style="dim")
            t.append(buffer, style="cyan")
            return t
        return Text(buffer, style="cyan")

    @staticmethod
    def _nick_cell(m: Match, kind: str) -> Text:
        # For non-conversation kinds the file format has no nick to
        # show; leave the cell genuinely empty rather than padding it
        # with a placeholder.
        if kind in ("server", "monitor", "user_core", "znc", "soju"):
            return Text("")
        nick_style = "dim" if m.is_event else nick_color(m.who)
        return Text(m.who, style=nick_style)

    def _render_rows(self) -> None:
        dt = self.query_one("#results", DataTable)
        dt.clear()
        if not dt.columns:
            self._rebuild_columns()
            return
        for m in self._matches:
            dt.add_row(*self._row_for(m))
        dt.show_header = bool(self._matches)
        dt.refresh()

    def _populate_tree(self) -> None:
        """Rebuild the tree from scratch using the stored unscoped hit
        counts. When 'hits only' is on, only networks/buffers with
        hits appear. Called on mount, system toggle, hits-only toggle,
        and after unscoped searches."""
        tree = self.query_one("#tree", Tree)
        # Save expand state.
        expanded = set()
        for net_node in tree.root.children:
            if net_node.is_expanded and net_node.data:
                expanded.add(net_node.data[1])
        tree.clear()
        tree.root.expand()
        net_hits = self._tree_net_hits
        buf_hits = self._tree_buf_hits
        has_hits = bool(net_hits)
        hide_unmatched = self._matched_only and has_hits
        seen: dict[str, dict[str, set[str | None]]] = {}
        for lf in self.index:
            if lf.network.startswith("(") and not self.query.include_system:
                continue
            kind = classify_buffer(lf.network, lf.buffer)
            if kind in ("znc", "soju", "service") and not self.query.include_system:
                continue
            if hide_unmatched and (lf.network, lf.buffer) not in buf_hits:
                continue
            seen.setdefault(lf.network, {}).setdefault(lf.buffer, set()).add(lf.day)
        by_net = {n: {b: len(days) for b, days in bufs.items()}
                  for n, bufs in seen.items()}
        for net in sorted(by_net, key=str.casefold):
            nh = net_hits.get(net, 0)
            label = f"{net} ({nh})" if has_hits and nh else net
            n = tree.root.add(label, data=("net", net))
            for buf, _cnt in sorted(by_net[net].items(), key=lambda x: x[0].lstrip("#&+!").casefold()):
                bh = buf_hits.get((net, buf), 0)
                blabel = f"{buf} ({bh})" if has_hits and bh else buf
                n.add_leaf(blabel, data=("buf", net, buf))
        # Restore expand state.
        for net_node in tree.root.children:
            if net_node.data and net_node.data[1] in expanded:
                net_node.expand()
        tree.refresh()

    # filter events ------------------------------------------------------
    def _update_tree_counts(self) -> None:
        """Called after every search. When unscoped, store the hit
        counts and rebuild the tree. When scoped (user clicked a
        network), leave the tree alone so it doesn't collapse or
        lose nodes from the feedback loop."""
        if self.query.networks or self.query.buffers:
            # Scoped search: don't touch the tree.
            return
        # Unscoped: compute and store global hit counts.
        net_hits: dict[str, int] = {}
        buf_hits: dict[tuple[str, str], int] = {}
        for m in self._matches:
            lf = self._by_path.get(m.path)
            if not lf:
                continue
            net_hits[lf.network] = net_hits.get(lf.network, 0) + 1
            key = (lf.network, lf.buffer)
            buf_hits[key] = buf_hits.get(key, 0) + 1
        self._tree_net_hits = net_hits
        self._tree_buf_hits = buf_hits
        self._populate_tree()

    @on(Input.Changed, "#q-text")
    def _on_text(self, e: Input.Changed) -> None:
        self.query.text = e.value
        self._schedule_search()

    @on(Input.Changed, "#q-nick")
    def _on_nick(self, e: Input.Changed) -> None:
        self.query.nick = e.value
        self._schedule_search()

    @on(Input.Changed, "#q-from")
    def _on_from(self, e: Input.Changed) -> None:
        self.query.date_from = _parse_date(e.value)
        self._schedule_search()

    @on(Input.Changed, "#q-to")
    def _on_to(self, e: Input.Changed) -> None:
        self.query.date_to = _parse_date(e.value)
        self._schedule_search()

    @on(Checkbox.Changed, "#q-regex")
    def _on_regex(self, e: Checkbox.Changed) -> None:
        self.query.regex = e.value
        self._schedule_search()

    @on(Checkbox.Changed, "#q-case")
    def _on_case(self, e: Checkbox.Changed) -> None:
        self.query.case_sensitive = e.value
        self._schedule_search()

    @on(Checkbox.Changed, "#q-events")
    def _on_events(self, e: Checkbox.Changed) -> None:
        # Chip inverted: checkbox on = show events. Internally the
        # query still uses hide_events as the source of truth.
        self.query.hide_events = not e.value
        self._schedule_search()

    @on(Checkbox.Changed, "#q-archives")
    def _on_archives(self, e: Checkbox.Changed) -> None:
        self.query.include_compressed = e.value
        self._schedule_search()

    @on(Checkbox.Changed, "#q-system")
    def _on_system(self, e: Checkbox.Changed) -> None:
        self.query.include_system = e.value
        self._populate_tree()
        self._schedule_search()

    @on(Checkbox.Changed, "#col-compact")
    def _on_compact(self, e: Checkbox.Changed) -> None:
        self._compact = e.value
        self._rebuild_columns()

    @on(Checkbox.Changed, "#col-matched")
    def _on_matched(self, e: Checkbox.Changed) -> None:
        self._matched_only = e.value
        # Full rebuild: structure changes (nodes added/removed).
        self._populate_tree()

    @on(Checkbox.Changed, "#col-context")
    def _on_col_context(self, e: Checkbox.Changed) -> None:
        box = self.query_one("#preview-box")
        box.set_class(not e.value, "hidden")

    @on(Input.Changed, "#ctx-span")
    def _on_ctx_span(self, e: Input.Changed) -> None:
        raw = e.value.strip()
        if not raw.isdigit():
            return
        try:
            value = int(raw)
        except ValueError:
            return
        self._context_span = max(1, min(9999, value))
        dt = self.query_one("#results", DataTable)
        if dt.cursor_row is not None and dt.cursor_row < len(self._matches):
            self._refresh_preview_for(self._matches[dt.cursor_row])


    def on_worker_state_changed(self, e: Worker.StateChanged) -> None:
        if e.worker.name == "_run" and e.state == WorkerState.RUNNING:
            self.sub_title = "searching\u2026"

    @on(Tree.NodeSelected, "#tree")
    def _on_tree(self, e: Tree.NodeSelected) -> None:
        data = e.node.data
        if not data:
            self.query.networks = set()
            self.query.buffers = set()
        elif data[0] == "net":
            self.query.networks = {data[1]}
            self.query.buffers = set()
        elif data[0] == "buf":
            self.query.networks = set()
            self.query.buffers = {(data[1], data[2])}
        self._schedule_search()

    _debounce_timer = None

    def _schedule_search(self) -> None:
        if self._debounce_timer is not None:
            self._debounce_timer.stop()
        # 300 ms debounce: collapses fast backspace bursts into one search.
        self._debounce_timer = self.set_timer(0.3, self._run)

    @work(exclusive=True)
    async def _run(self) -> None:
        dt = self.query_one("#results", DataTable)
        dt.clear()
        self._matches.clear()
        # Clear the preview too; otherwise a new search that yields zero
        # hits leaves stale context from the previous query on screen,
        # which reads as "no results but here's some context anyway".
        self._reset_preview()
        title = self.query_one("#results-title", Static)
        # A search needs at least a Query or a Nick. Tree/date/event
        # scoping alone doesn't drive a search. Explain rather than
        # silently leaving the pane empty.
        nicks_set = any(n for n in re.split(r"[,\s]+", self.query.nick.strip()))
        if not self.query.text and not nicks_set:
            self._show_onboarding()
            self._update_tree_counts()
            self.sub_title = "idle"
            return
        paths = select_files(self.index, self.query)
        # Collect during rg, render once at end. Cancelled searches
        # then cost zero render work.
        collected: list[Match] = []
        truncated = False
        async for m in run_search(self.query, paths):
            collected.append(m)
            n = len(collected)
            if n % 100 == 0:
                title.update(
                    f"Results - searching… {n} hits / {len(paths)} files"
                )
            if n >= 500:
                truncated = True
                break
        collected.sort(key=_match_sort_key)
        self._matches = collected
        self._render_rows()
        self._update_tree_counts()
        n = len(self._matches)
        hits = f"{n}+" if truncated else str(n)
        suffix = " (truncated; try adding a nick or date range)" if truncated else ""
        title.update(f"Results - {hits} hits / {len(paths)} files{suffix}")
        # Echo the active query + non-default scope in the title bar so
        # it's visible even when the filter card is F2-hidden.
        parts = []
        if self.query.text:
            parts.append(f'"{self.query.text}"')
        if self.query.nick.strip():
            parts.append(f"@{self.query.nick.strip()}")
        label = " ".join(parts) or "search"
        scope = []
        if self.query.include_compressed:
            scope.append("+archives")
        if self.query.include_system:
            scope.append("+system")
        if not self.query.hide_events:
            scope.append("+events")
        scope_str = (" \u00b7 " + " ".join(scope)) if scope else ""
        self.sub_title = f"{label}{scope_str} \u00b7 {hits} hits"

    def _show_onboarding(self) -> None:
        """Show index stats and key hints in the context pane."""
        s = self._stats
        size = humanize_bytes(s.get("bytes", 0)) if s.get("bytes") else ""
        kinds = s.get("kinds", {})
        span = ""
        if s.get("oldest") and s.get("newest"):
            span = f"{s['oldest']} \u2192 {s['newest']}"
        lines = [
            "",
            f"  [b]{s.get('total', len(self.index)):,}[/b] log files" + (f"  ({size})" if size else ""),
            f"  [b]{s.get('networks', 0)}[/b] networks  \u00b7  "
            f"[b]{s.get('channels', 0)}[/b] channels  \u00b7  "
            f"[b]{s.get('pms', 0)}[/b] private chats",
        ]
        if span:
            lines.append(f"  {span}")
        # Buffer kind breakdown.
        detail = []
        if kinds.get("server"):
            detail.append(f"{kinds['server']} server")
        if kinds.get("znc"):
            detail.append(f"{kinds['znc']} ZNC")
        if kinds.get("soju"):
            detail.append(f"{kinds['soju']} soju")
        if kinds.get("service"):
            detail.append(f"{kinds['service']} services")
        if kinds.get("monitor"):
            detail.append(f"{kinds['monitor']} monitor")
        if s.get("compressed"):
            detail.append(f"{s['compressed']} archived (.gz/.zst)")
        if s.get("legacy"):
            detail.append(f"{s['legacy']} legacy")
        if detail:
            lines.append(f"  [dim]{' \u00b7 '.join(detail)}[/dim]")
        if s.get("elapsed_ms") is not None:
            tag = "cached" if s.get("cache_hit") else "built"
            lines.append(f"  Index {tag} in [b]{s['elapsed_ms']}[/b] ms")
        lines += [
            "",
            "  [b]/[/b] search  \u00b7  [b]Ctrl+L[/b] tree  \u00b7  [b]?[/b] help",
        ]
        with self.batch_update():
            self.query_one("#results-title", Static).update("Results")
            self.query_one("#results", DataTable).clear()
            # Show the logs directory path as the preview title.
            self.query_one("#preview-title", Static).update(
                s.get("logs_dir", str(self.logs_dir))
            )
            preview = self.query_one("#preview-content", RichLog)
            preview.clear()
            preview.write(Text.from_markup("\n".join(lines)))

    def _reset_preview(self) -> None:
        self.query_one("#preview-title", Static).update(
            "Context - select a result"
        )
        preview = self.query_one("#preview-content", RichLog)
        preview.clear()
        preview.write("(no selection)")

    @on(DataTable.RowHighlighted, "#results")
    def _on_row(self, e: DataTable.RowHighlighted) -> None:
        # Debounce: cursor flying through the table via PgDn/j/k should
        # not trigger one context read per row. Coalesce bursts into a
        # single read for whatever row the cursor ends up on.
        if e.cursor_row is None or e.cursor_row >= len(self._matches):
            return
        if self._preview_timer is not None:
            self._preview_timer.stop()
        m = self._matches[e.cursor_row]
        self._preview_timer = self.set_timer(
            0.12, lambda: self._refresh_preview_for(m)
        )

    def _refresh_preview_for(self, m: Match) -> None:
        span = self._context_span
        table, match_row = read_context(
            m.path, m.line_no, span, self.query.hide_events, self._use_osc8,
        )
        preview = self.query_one("#preview-content", RichLog)
        preview.clear()
        preview.write(table)
        rel = os.path.relpath(m.path, self.logs_dir)
        ev = "" if self.query.hide_events else " (including events)"
        self.query_one("#preview-title", Static).update(
            f"Context: grep --context={span} --line-number --extended-regexp "
            f"'…' {rel}  →  line {m.line_no}{ev}"
        )
        # Scroll so the matched line sits in the middle of the visible
        # area, with lines both above and below.
        def _center() -> None:
            visible = preview.size.height or 20
            target_y = max(0, match_row - visible // 2)
            preview.scroll_to(y=target_y, animate=False)

        self.call_after_refresh(_center)

    # actions ------------------------------------------------------------
    def action_focus_query(self) -> None:
        self.query_one("#q-text", Input).focus()

    def action_focus_tree(self) -> None:
        self.query_one("#tree", Tree).focus()

    def action_toggle_filters(self) -> None:
        bar = self.query_one("#filters")
        bar.set_class(not bar.has_class("hidden"), "hidden")

    def action_toggle_context(self) -> None:
        # Flip the 'context' checkbox; the existing handler on the
        # checkbox's Changed event takes care of hiding / showing the
        # pane, so visible state stays in sync with the knob.
        cb = self.query_one("#col-context", Checkbox)
        cb.value = not cb.value

    def action_toggle_tree(self) -> None:
        pane = self.query_one("#tree-pane")
        pane.set_class(not pane.has_class("hidden"), "hidden")

    def action_help(self) -> None:
        self.push_screen(HelpScreen())

    def _ensure_clipboard_consent(self, then: str) -> bool:
        """On first yank attempt, show a dialog. Returns True if
        already consented; False if the dialog was pushed (caller
        should return early and let the callback re-invoke `then`)."""
        if self._clipboard_consent:
            return True

        def _on_answer(yes: bool) -> None:
            if yes:
                self._clipboard_consent = True
                self.notify("Clipboard writes enabled for this session.", timeout=3)
                if then == "yank":
                    self.action_yank()
                elif then == "yank_context":
                    self.action_yank_context()

        self.push_screen(ClipboardConsent(), _on_answer)
        return False

    def action_yank(self) -> None:
        if not self._ensure_clipboard_consent("yank"):
            return
        dt = self.query_one("#results", DataTable)
        row = dt.cursor_row
        if row is None or row >= len(self._matches):
            return
        m = self._matches[row]
        line = f"{m.timestamp}\t{m.who}\t{m.message}"
        self.copy_to_clipboard(line)
        warn = " (likely clipped by terminal)" if _clipboard_too_large(line) else ""
        self.notify(f"Row copied.{warn}", timeout=2)

    def action_yank_context(self) -> None:
        """Focus-aware pane yank.

        Whichever pane the user last clicked / focused is the copy
        target. This sidesteps the terminal's rectangular-select
        picking up whitespace from neighbouring panes:

          * tree focused    -> networks + buffers listing as text
          * results focused -> all current result rows as TSV
          * context focused -> context window for the selected row
          * nothing focused -> context window (same default as before)
        """
        if not self._ensure_clipboard_consent("yank_context"):
            return
        focused = self.focused
        target = "context"  # default
        if focused is not None:
            # Walk up the focus ancestry to identify which pane owns it.
            fid = focused.id or ""
            anc_ids = {w.id for w in focused.ancestors if w.id}
            if fid == "tree" or "tree-pane" in anc_ids:
                target = "tree"
            elif fid == "results" or "results-box" in anc_ids:
                target = "results"
            elif "preview" in fid or "preview-box" in anc_ids:
                target = "context"

        if target == "tree":
            tree = self.query_one("#tree", Tree)
            lines = []
            for net_node in tree.root.children:
                lines.append(str(net_node.label))
                for buf_node in net_node.children:
                    lines.append(f"  {buf_node.label}")
            if not lines:
                self.notify("Tree is empty.", severity="warning")
                return
            payload = "\n".join(lines)
            self.copy_to_clipboard(payload)
            warn = " (likely clipped by terminal)" if _clipboard_too_large(payload) else ""
            self.notify(f"Copied tree ({len(lines)} lines).{warn}", timeout=3)
            return

        if target == "results":
            if not self._matches:
                self.notify("No results to copy.", severity="warning")
                return
            lines = [
                f"{m.timestamp}\t{m.who}\t{m.message}"
                for m in self._matches
            ]
            payload = "\n".join(lines)
            self.copy_to_clipboard(payload)
            warn = " (likely clipped by terminal)" if _clipboard_too_large(payload) else ""
            self.notify(f"Copied {len(lines)} result rows.{warn}", timeout=3)
            return

        # context (default)
        dt = self.query_one("#results", DataTable)
        row = dt.cursor_row
        if row is None or row >= len(self._matches):
            self.notify("No context to copy.", severity="warning")
            return
        m = self._matches[row]
        lines = _plain_context_lines(
            m.path, m.line_no, self._context_span, self.query.hide_events,
        )
        if not lines:
            self.notify("No context to copy.", severity="warning")
            return
        payload = "\n".join(lines)
        copy_to_clipboard_osc52(payload)
        warn = " (likely clipped by terminal)" if _osc52_payload_size(payload) > OSC52_SAFE_BYTES else ""
        self.notify(f"Copied {len(lines)} context lines.{warn}", timeout=3)

    def action_export(self) -> None:
        if not self._matches:
            self.notify("Nothing to export.", severity="warning")
            return
        stamp = datetime.now().strftime("%Y%m%d-%H%M%S")
        out = Path("/tmp") / f"weelog-hindsight-{stamp}.tsv"

        def _do_export(confirm: bool) -> None:
            if not confirm:
                return
            # csv.writer with excel-tab quotes any field containing a
            # tab, newline, or quote, so messages with embedded tabs
            # (parse_line uses split("\t", 2)) don't shred the layout.
            with open_w(out, encoding="utf-8", newline="") as f:
                f.write("# timestamp\tbuffer\tnick\tmessage\tsource\n")
                w = csv.writer(f, dialect="excel-tab")
                for m in self._matches:
                    buf = Path(m.path).stem.split(".")[0]
                    src = os.path.relpath(m.path, self.logs_dir)
                    w.writerow([
                        m.timestamp, buf, m.who, m.message,
                        f"{src}:{m.line_no}",
                    ])
            self.notify(f"Exported {len(self._matches)} rows → {out}", timeout=5)

        self.push_screen(ConfirmExport(out, len(self._matches)), _do_export)

    def action_open_pager(self) -> None:
        dt = self.query_one("#results", DataTable)
        row = dt.cursor_row
        if row is None or row >= len(self._matches):
            return
        m = self._matches[row]
        # PAGER follows the usual convention of being shell-evaluated
        # ("less -R", "bat --paging=always", ...). Path comes from the
        # filesystem so it must be shell-quoted to survive odd names.
        pager = os.environ.get("PAGER", "less")
        quoted = shlex.quote(m.path)
        line = f"+{m.line_no}"
        if m.path.endswith(".gz"):
            cmd = f"zcat {quoted} | {pager} {line}"
        elif m.path.endswith(".zst"):
            cmd = f"zstdcat {quoted} | {pager} {line}"
        else:
            cmd = f"{pager} {line} {quoted}"
        with self.suspend():
            subprocess.run(cmd, shell=True, check=False)


def _parse_date(s: str) -> date | None:
    s = s.strip()
    if not s:
        return None
    try:
        return date.fromisoformat(s)
    except ValueError:
        return None


HELP_EPILOG = """\
Filters:
  Query         text or regex
  regex/case    smart-case off, regex mode
  hide events   drop join/part/topic/mode lines
  archives      also search rotated, compressed log files (.gz, .zst)
  meta          include weechat's own aggregator buffers (core.chanmon
                etc.). Off by default because they duplicate real lines
  Nick          one or more nicks (anchored; no body mentions)
  From / To     YYYY-MM-DD inclusive
  Columns       toggle date/ago/channel/nick columns
  clipboard     enables y; clipboard is not read until checked
  context       show or hide the Context pane at the bottom

Keys:
  Ctrl+P palette · / Query · Ctrl+L tree · F2 toggle filters
  Enter open in $PAGER · y yank row · Y yank ctx · Ctrl+E export · Ctrl+Q quit
  Tab / arrows / Space / PgUp/PgDn work everywhere

Logs directory:
  --logs DIR              explicit path (highest priority)
  $WEELOG_DIR             environment variable fallback
  If neither is set, the tool exits with a hint.

Theme:  --theme auto|dark|light|<textual-theme-name>
URLs are linkified (OSC 8) except where the terminal already does it
(Kitty, WezTerm, iTerm2, Ghostty, foot, VTE).

A search needs at least a Query or a Nick. Other knobs narrow, they
don't drive.
"""


def main() -> None:
    ap = argparse.ArgumentParser(
        prog="weelog-hindsight",
        description=(
            "weelog-hindsight (Hindsight). A TUI search over a weechat logs "
            "directory. Indexes "
            "both the legacy flat layout (plugin.name.weechatlog[.N][.gz]) and "
            "the dated YYYY/<network>/<buffer>.MM-DD.log hierarchy; full-text "
            "search is powered by ripgrep and handles rotated .gz/.zst files "
            "transparently."
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=HELP_EPILOG,
    )
    ap.add_argument(
        "--logs", type=Path, metavar="DIR",
        help=(
            "weechat logs directory (typically ~/.local/share/weechat/logs). "
            "Falls back to the WEELOG_DIR environment variable if --logs is "
            "not given."
        ),
    )
    ap.add_argument(
        "--theme", default="auto",
        help=(
            "'auto' (default, honours COLORFGBG), 'dark', 'light', or any "
            "Textual theme name (e.g. 'gruvbox', 'nord', 'catppuccin-mocha')."
        ),
    )
    args = ap.parse_args()

    # Resolve logs directory: --logs flag > $WEELOG_DIR env var.
    logs_source = "--logs"
    if args.logs is None:
        env = os.environ.get("WEELOG_DIR")
        if env:
            args.logs = Path(env)
            logs_source = "$WEELOG_DIR"
        else:
            ap.error(
                "no logs directory given. Pass --logs DIR or set the "
                "WEELOG_DIR environment variable."
            )

    if not shutil.which("rg"):
        sys.exit("error: ripgrep (rg) not found on PATH")
    if not args.logs.exists():
        sys.exit(
            f"error: {args.logs} (from {logs_source}) does not exist.\n"
            "  The default weechat logs path is "
            "~/.local/share/weechat/logs"
        )
    if not args.logs.is_dir():
        sys.exit(
            f"error: {args.logs} (from {logs_source}) is not a directory."
        )

    # Install the write policy before any write can happen.
    _set_write_policy(
        logs_dir=args.logs,
        cache_dir=cache_path().parent,
        export_dir=Path("/tmp"),
    )
    cache_real = cache_path().resolve()
    logs_real = args.logs.resolve()
    if cache_real == logs_real or logs_real in cache_real.parents:
        sys.exit(
            f"error: the index cache path {cache_real} is inside the "
            f"logs directory {logs_real}. Cache and logs must not "
            "overlap. Point $XDG_CACHE_HOME elsewhere and retry."
        )

    index, stats = load_or_build_index(args.logs)
    if not index:
        # Give the user something actionable: show what's actually in the
        # directory and what we were looking for.
        try:
            sample = sorted(os.listdir(args.logs))[:6]
        except OSError as e:
            sys.exit(f"error: cannot read {args.logs}: {e}")
        listing = ", ".join(sample) if sample else "(empty)"
        logger_conf = (
            Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
            / "weechat" / "logger.conf"
        )
        default_hint = "~/.local/share/weechat/logs"
        if logger_conf.exists():
            default_hint += f" (confirm via 'logger.file.path' in {logger_conf})"
        sys.exit(
            f"error: {args.logs} does not look like a weechat logs directory.\n"
            f"  found: {listing}\n"
            f"  expected: files matching '<plugin>.<name>.weechatlog[.N][.gz]' "
            f"or a 'YYYY/<network>/<buffer>.MM-DD.log' tree.\n"
            f"  default weechat logs path: {default_hint}"
        )
    Hindsight(args.logs, index, theme=args.theme, index_stats=stats).run()


if __name__ == "__main__":
    main()
