#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.12"
# dependencies = ["textual>=0.80", "rich>=13"]
# ///
"""TUI search over a weechat logs directory.

Handles both layouts described in the WeeChat Buffer logging section
(https://weechat.org/files/doc/stable/weechat_user.en.html#buffer_logging):
the flat legacy `$plugin.$name.weechatlog[.N][.gz]` and the dated
`YYYY/<network>/<buffer>.MM-DD.log` hierarchy. Each log line is TSV:
`YYYY-MM-DD HH:MM:SS \\t <nick-or-event-prefix> \\t <message>`.

Search is ripgrep. The tool indexes file paths once (cached under
`$XDG_CACHE_HOME/weelog-hindsight/`) and hands rg an explicit path list
per query so scoped searches touch only the relevant files.

The script is gated such that it can never alter or write to the
user-supplied --logs directory, only XDG cache.

Usage: weelog-hindsight --logs ~/.local/share/weechat/logs
       WEELOG_DIR=~/.local/share/weechat/logs weelog-hindsight
Requires: ripgrep on $PATH; Python 3.12+; textual + rich (via the PEP
723 shebang under `uv`, or a manual venv).
"""
from __future__ import annotations

# Deliberate pylint disables for a single-file TUI script: short locals,
# self-describing helpers, long CSS/help literals, wide TUI class surface.
# pylint: disable=C0103,C0114,C0115,C0116,C0301,R0902,R0903,R0912,R0913,R0914,R0917

