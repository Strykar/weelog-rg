    Screen.-narrow #tree-pane { width: 22; }
    Screen.-narrow #preview-box { height: 18; }
    Screen.-narrow #filters .section-label { display: none; }
    Screen.-narrow #filters { padding: 0 1; margin: 0 1 0 1; }
    Screen.-narrow #filters Input { width: 26; }
    Screen.-narrow #filters .short { width: 12; }
    Screen.-wide #tree-pane { width: 36; }
    Screen.-wide #preview-box { height: 34; }
