    def __init__(
        self,
        logs_dir: Path,
        index: list[LogFile],
        theme: str = "auto",
        index_stats: dict | None = None,
    ):
        super().__init__()
        self.logs_dir = logs_dir
        self.index = index
        # path -> LogFile lookup so display uses the indexed buffer name
        # (Path.stem only strips one extension, breaks on legacy logs).
        self._by_path: dict[str, LogFile] = {lf.path: lf for lf in index}
        nick_wp, nick_ws = read_weechat_nick_wrappers()
        self.query = Query(
            nick_wrap_prefix=nick_wp,
            nick_wrap_suffix=nick_ws,
        )
        self._matches: list[Match] = []
        self._compact = False
        self._matched_only = False
        # Last UNSCOPED hit counts for the tree. Tree always reflects
        # global results, not scoped (per-network) ones.
        self._tree_net_hits: dict[str, int] = {}
        self._tree_buf_hits: dict[tuple[str, str], int] = {}
        self._theme_pref = theme
        self._clipboard_consent = False
        self._use_osc8 = not terminal_autolinks_urls()
        self._stats = index_stats or {}
        self._context_span = 100       # configurable via the 'context ±' input
        self._preview_timer = None     # debounces RowHighlighted fires

    def compose(self) -> ComposeResult:
