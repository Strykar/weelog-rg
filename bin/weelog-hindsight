# ---------- terminal-friendly rendering helpers ----------

# 16 distinct 256-colour palette entries, skipping red/white/black tones so
# nicks don't collide with error colours or the default foreground.
_NICK_PALETTE = (
    39, 45, 51, 75, 81, 111, 117, 147, 153, 183, 189, 215, 221, 222, 228, 229,
)


def nick_color(nick: str) -> str:
    if not nick:
        return "white"
    # Stable hash across runs; Python's hash() is randomised per interpreter.
    h = zlib.crc32(nick.encode("utf-8"))
    return f"color({_NICK_PALETTE[h % len(_NICK_PALETTE)]})"


_URL_RE = re.compile(r"https?://[^\s<>\"'`()\[\]{}]+")


def terminal_autolinks_urls() -> bool:
    """True if the current terminal auto-detects URLs without OSC 8 help.

    Kitty (detect_urls defaults to yes), WezTerm (hyperlink_rules default),
    iTerm2, Ghostty, foot, and gnome-terminal all auto-linkify. We skip
    emitting OSC 8 in those so we don't paint links on top of links.
    """
    term = os.environ.get("TERM", "")
    term_program = os.environ.get("TERM_PROGRAM", "").lower()
    # Kitty sets TERM=xterm-kitty and KITTY_WINDOW_ID
    if term == "xterm-kitty" or os.environ.get("KITTY_WINDOW_ID"):
        return True
    if term_program in {"wezterm", "iterm.app", "ghostty"}:
        return True
    if os.environ.get("WEZTERM_EXECUTABLE") or os.environ.get("GHOSTTY_RESOURCES_DIR"):
        return True
    if os.environ.get("VTE_VERSION"):  # gnome-terminal, tilix, xfce4-terminal, …
        return True
    return "foot" in term


def render_message(msg: str, use_osc8: bool) -> Text:
    """Return a Rich Text for a message, optionally linkifying URLs."""
    if not use_osc8 or "http" not in msg:
        return Text(msg)
    out = Text()
    idx = 0
    for m in _URL_RE.finditer(msg):
        if m.start() > idx:
            out.append(msg[idx:m.start()])
        url = m.group(0)
        out.append(url, style=f"link {url}")
        idx = m.end()
    if idx < len(msg):
        out.append(msg[idx:])
    return out


# WeeChat colour escapes. 0x19 introduces a colour/attribute sequence
# whose argument grammar depends on the next byte; the alternatives
# below cover the well-defined forms (basic NN, foreground FNN,
# background BNN, combined *NNNN, terminal-256 @NNNNN, 24-bit !NNNNNN).
# 0x1A / 0x1B / 0x1C are single attribute bytes with no arguments. If
# 0x19 isn't followed by a recognised pattern, just the intro byte is
# stripped to stay conservative around visible text.
#
# Branch ordering is load-bearing — the longer 24-bit and combined-*
# forms must sit before the shorter ones so they consume their full
# argument byte run. tests/test_logger_options.py exercises every
# branch in `test_strip_weechat_colors_regex`.
_WEECHAT_COLOR_RE = re.compile(
    r"\x19(?:"
    r"[FB]?\d{2}"
    r"|\*[*!@~/_|]?\d{4,6}"
    r"|\*[FB]?\d{2}"
    r"|@\d{5}"
    r"|![0-9a-fA-F]{6}"
    r")?"
    r"|[\x1a\x1b\x1c]"
)


def strip_weechat_colors(text: str) -> str:
    """Remove WeeChat colour-control escape sequences from a log line."""
    # Guard must list every intro byte the regex can match, including
    # \x1b (the bare attribute byte). Missing one silently leaves it in.
    if not any(b in text for b in "\x19\x1a\x1b\x1c"):
        return text
    return _WEECHAT_COLOR_RE.sub("", text)


def parse_timestamp(ts: str) -> "datetime | None":
    """Parse a timestamp from any WeeChat logger.file.time_format the
    docs ship with: the user-overridable `%Y-%m-%d %H:%M:%S` and the
    new default `%@%F %T.%fZ` (ISO 8601 with microseconds + Z).

    ISO-Z inputs come back as aware UTC datetimes; classic inputs come
    back naive. Callers that subtract from `now` must match tzinfo."""
    if not ts:
        return None
    s = ts.strip()
    # Python 3.11+ fromisoformat accepts T/space, fractional seconds,
    # and a trailing Z (returning an aware UTC datetime in that case).
    try:
        return datetime.fromisoformat(s)
    except ValueError:
        pass
    try:
        return datetime.strptime(s, "%Y-%m-%d %H:%M:%S")
    except ValueError:
        return None


def extract_hms(ts: str) -> str:
    """Pull `HH:MM:SS` out of any timestamp format we accept."""
    dt = parse_timestamp(ts)
    if dt is not None:
        return dt.strftime("%H:%M:%S")
    # Best-effort fallback: split on T or space, drop fractional/Z bits.
    return ts.replace("T", " ").split(" ", 1)[-1].split(".")[0]


def extract_date(ts: str) -> "date | None":
    dt = parse_timestamp(ts)
    return dt.date() if dt is not None else None


class _ProcReader(io.TextIOWrapper):
    # TextIOWrapper that reaps its backing subprocess on close, so
    # each .zst preview doesn't leave a zombie zstdcat behind.
    def __init__(self, proc: subprocess.Popen):
        super().__init__(proc.stdout, encoding="utf-8", errors="replace")
        self._proc = proc

    def close(self) -> None:
        try:
            super().close()
        finally:
            if self._proc.returncode is None:
                try:
                    self._proc.wait(timeout=1.0)
                except subprocess.TimeoutExpired:
                    self._proc.kill()
                    self._proc.wait()
            # Surface corrupt .zst files the same way read_context
            # surfaces gzip.BadGzipFile: callers catch OSError.
            if self._proc.returncode and self._proc.returncode > 0:
                raise OSError(
                    f"zstdcat exited {self._proc.returncode} (corrupt .zst?)"
                )


def open_log(path: str):
    """Open a log file for reading, transparently handling gzip and
    zstd rotated files. Returns a text-mode file object. zstd uses
    the system `zstdcat` (ships with the `zstd` package) so we don't
    pull in a Python zstd dependency."""
    if path.endswith(".gz"):
        return gzip.open(path, "rt", encoding="utf-8", errors="replace")
    if path.endswith(".zst"):
        proc = subprocess.Popen(
            ["zstdcat", path],
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
        )
        return _ProcReader(proc)
    return open(path, "rt", encoding="utf-8", errors="replace")


def read_weechat_nick_wrappers() -> tuple[str, str]:
    """Look up the user's `logger.file.nick_prefix` and `nick_suffix`
    from weechat's logger.conf so a wrapper like `<alice>` or `|alice|`
    is invisible to nick filtering and display. Returns ("", "") if
    the file isn't found or the keys aren't set."""
    candidates = [
        Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
        / "weechat" / "logger.conf",
        Path.home() / ".weechat" / "logger.conf",
    ]
    for path in candidates:
        try:
            text = path.read_text(encoding="utf-8")
        except OSError:
            continue
        prefix = ""
        suffix = ""
        in_file = False
        for raw in text.splitlines():
            line = raw.strip()
            if line.startswith("[") and line.endswith("]"):
                in_file = (line == "[file]")
                continue
            if not in_file:
                continue
            for key in ("nick_prefix", "nick_suffix"):
                if line.startswith(f"{key} ="):
                    val = line.split("=", 1)[1].strip()
                    if len(val) >= 2 and val[0] == val[-1] == '"':
                        val = val[1:-1]
                    if key == "nick_prefix":
                        prefix = val
                    else:
                        suffix = val
        return prefix, suffix
    return "", ""


def strip_nick_wrappers(who: str, prefix: str, suffix: str) -> str:
    """Remove configured nick_prefix/nick_suffix from a parsed `who`."""
    if prefix and who.startswith(prefix):
        who = who[len(prefix):]
    if suffix and who.endswith(suffix):
        who = who[: -len(suffix)]
    return who


def format_relative(ts: str) -> str:
    """'2026-03-14 10:22' → '3d' style short relative marker."""
    when = parse_timestamp(ts)
    if when is None:
        return ""
    # Match tzinfo before subtracting; ISO-Z timestamps are aware UTC,
    # classic timestamps are naive local. Mismatched arithmetic raises.
    now = datetime.now(when.tzinfo) if when.tzinfo else datetime.now()
    delta = now - when
    days = delta.days
    if days < 0:
        return ""
    if days == 0:
        h = delta.seconds // 3600
        return f"{h}h" if h else f"{delta.seconds // 60}m"
    if days < 30:
        return f"{days}d"
    if days < 365:
        return f"{days // 30}mo"
    return f"{days // 365}y"


def _clipboard_too_large(text: str) -> bool:
    """True if the clipboard payload is likely to be silently truncated
    by tmux or similarly constrained terminal multiplexers (~74 KB)."""
    return len(text.encode("utf-8")) > 70_000


# ---------- index ----------

# Legacy mask: $plugin.$name.weechatlog (+ optional .N rotation + .gz/.zst).
LEGACY_RE = re.compile(
    r"^(?P<plugin>[^.]+)\.(?P<rest>.+)\.weechatlog(?:\.\d+)?"
    r"(?P<comp>\.gz|\.zst)?$"
)
# Dated mask (irc only): `%Y/$server/$channel.%m-%d.log`
DATED_RE = re.compile(r"^(?P<buf>.+)\.(?P<md>\d{2})-(?P<md2>\d{2})\.log$")
YEAR_RE = re.compile(r"^\d{4}$")


@dataclass(frozen=True)
class LogFile:
    path: str
    network: str
    buffer: str
    day: str | None  # YYYY-MM-DD or None for legacy single-file buffers
    compressed: bool  # True for .gz or .zst rotated siblings


# classify_buffer(network, buffer) returns one of:
#   channel | pm | server | znc | soju | service | monitor | user_core | other
# See test_classifier.py for the full mapping.

def is_soju_buffer(network: str, buffer: str) -> bool:
    """Soju bouncers expose a single control buffer named BouncerServ
    on every bridged network. Weechat's default logger writes this
    lowercase (logger.file.name_lower_case = on), so the on-disk
    buffer name is `bouncerserv`. casefold covers users who've flipped
    the lower-case knob off. Unlike ZNC, soju doesn't use an asterisk
    prefix/suffix on the control nick."""
    del network
    return buffer.casefold() == "bouncerserv"


# Atheme / Anope / ircservices-style services bots. These appear as
# unprefixed query buffers named after the service (weechat lowercases
# buffer names by default). Matched case-insensitively.
_SERVICE_NAMES = frozenset({
    "chanserv", "nickserv", "memoserv", "operserv", "botserv",
    "hostserv", "helpserv", "global", "authserv", "saslserv",
    "statserv", "gameserv", "groupserv", "infoserv", "spamserv",
    "rootserv", "alis",
})


def is_service_buffer(buffer: str) -> bool:
    return buffer.casefold() in _SERVICE_NAMES


def is_znc_buffer(buffer: str) -> bool:
    # ZNC module buffers can be prefix- OR suffix-asterisk depending
    # on the bouncer's StatusPrefix setting. Both *status and status*
    # (and *nickserv / nickserv*, etc.) show up in the wild.
    return bool(buffer) and (buffer.startswith("*") or buffer.endswith("*"))


def classify_buffer(network: str, buffer: str) -> str:
    if network == "(core)":
        if buffer in ("chanmon", "highmon", "newsmon"):
            return "monitor"
        if buffer == "weechat":
            return "user_core"
        return "other"
    if buffer == "(server)" or buffer == network:
        return "server"
    if is_znc_buffer(buffer):
        return "znc"
    if is_soju_buffer(network, buffer):
        return "soju"
    if is_service_buffer(buffer):
        return "service"
    if buffer and buffer[0] in "#&+!":
        return "channel"
    return "pm"


def build_index(logs_dir: Path) -> list[LogFile]:
    out: list[LogFile] = []
    for entry in os.scandir(logs_dir):
        if entry.is_file():
            m = LEGACY_RE.match(entry.name)
            if m:
                plugin = m["plugin"]
                rest = m["rest"]
                if plugin == "irc" and rest.startswith("server."):
                    # IRC server buffer: irc.server.<network>.weechatlog
                    network = rest[len("server."):]
                    buffer = "(server)"
                elif plugin == "irc" and "." in rest:
                    network, buffer = rest.split(".", 1)
                else:
                    # core.weechat, core.highmon, xfer.foo, etc.: no server.
                    network = f"({plugin})"
                    buffer = rest
                out.append(LogFile(
                    path=entry.path,
                    network=network,
                    buffer=buffer,
                    day=None,
                    compressed=bool(m["comp"]),
                ))
        elif entry.is_dir() and YEAR_RE.match(entry.name):
            year = entry.name
            for net_entry in os.scandir(entry.path):
                if not net_entry.is_dir():
                    continue
                network = net_entry.name
                for f in os.scandir(net_entry.path):
                    if not f.is_file():
                        continue
                    m = DATED_RE.match(f.name)
                    if not m:
                        continue
                    day = f"{year}-{m['md']}-{m['md2']}"
                    out.append(LogFile(
                        path=f.path,
                        network=network,
                        buffer=m["buf"],
                        day=day,
                        compressed=False,
                    ))
    return out


def cache_path() -> Path:
    base = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache"))
    return base / "weelog-hindsight" / "index.json"


# Write allowlist. Set by main(); enforced by assert_writable().
# Any write outside these roots, or inside --logs, aborts the process.
_ALLOWED_WRITE_ROOTS: list[Path] = []
_LOGS_DIR_RESOLVED: Path | None = None
_EXPORT_NAME_PREFIX = "weelog-hindsight-"
_EXPORT_SUFFIX = ".tsv"


def _set_write_policy(logs_dir: Path, cache_dir: Path, export_dir: Path) -> None:
    global _LOGS_DIR_RESOLVED
    _LOGS_DIR_RESOLVED = logs_dir.resolve()
    _ALLOWED_WRITE_ROOTS.clear()
    _ALLOWED_WRITE_ROOTS.extend([cache_dir.resolve(), export_dir.resolve()])


def _current_allowed_roots() -> list[Path]:
    """Recomputed on every check so env changes (e.g. test monkeypatching
    $XDG_CACHE_HOME) don't leave a stale allowlist. Extra roots added by
    _set_write_policy are preserved."""
    roots = [cache_path().parent.resolve(), Path("/tmp").resolve()]
    for r in _ALLOWED_WRITE_ROOTS:
        if r not in roots:
            roots.append(r)
    return roots


def open_w(path: Path, **kwargs):
    """Single chokepoint for filesystem writes: routes the path through
    the write gate, then opens for writing. Any write that doesn't go
    through this helper is a smell — grep for `open(..., "w")` and
    `write_text` at review time."""
    assert_writable(path)
    return path.open("w", **kwargs)


def assert_writable(path: Path) -> None:
    """Refuse any write that isn't (a) under an allowlisted root,
    (b) outside --logs, and (c) for /tmp targets, named with our
    export prefix + .tsv suffix. Aborts with SystemExit on failure."""
    resolved = path.resolve()
    roots = _current_allowed_roots()
    # (1) allowlist membership
    ok = False
    for root in roots:
        try:
            resolved.relative_to(root)
            ok = True
            break
        except ValueError:
            continue
    if not ok:
        sys.exit(
            f"error: refused to write {resolved}. Permitted write roots "
            f"are {[str(r) for r in roots]}. This is a cardinal guard: "
            "the tool never writes outside its cache or explicit export "
            "location."
        )
    # No overlap with --logs, even when --logs is /tmp.
    if _LOGS_DIR_RESOLVED is not None:
        try:
            resolved.relative_to(_LOGS_DIR_RESOLVED)
            sys.exit(
                f"error: refused to write {resolved} because it sits "
                f"inside --logs ({_LOGS_DIR_RESOLVED}). Logs are "
                "strictly read-only."
            )
        except ValueError:
            pass
    # /tmp targets must carry our export prefix/suffix.
    cache_root = cache_path().parent.resolve()
    is_cache = False
    try:
        resolved.relative_to(cache_root)
        is_cache = True
    except ValueError:
        pass
    if not is_cache:
        name = resolved.name
        if not (name.startswith(_EXPORT_NAME_PREFIX) and name.endswith(_EXPORT_SUFFIX)):
            sys.exit(
                f"error: refused to write {resolved}. Export files must "
                f"be named '{_EXPORT_NAME_PREFIX}*{_EXPORT_SUFFIX}'."
            )


def load_or_build_index(logs_dir: Path) -> tuple[list[LogFile], dict]:
    start = time.monotonic()
    key = _index_key(logs_dir)
    cp = cache_path()
    cache_hit = False
    idx: list[LogFile] | None = None
    if cp.exists():
        try:
            data = json.loads(cp.read_text())
            if data.get("key") == key:
                idx = [LogFile(**e) for e in data["entries"]]
                cache_hit = True
        except (OSError, json.JSONDecodeError, TypeError, KeyError):
            # Cache is derived state; rebuild on any read failure.
            idx = None
    if idx is None:
        idx = build_index(logs_dir)
        cp.parent.mkdir(parents=True, exist_ok=True)
        with open_w(cp, encoding="utf-8") as f:
            json.dump({"key": key, "entries": [asdict(e) for e in idx]}, f)
    # Aggregate stats in one pass for the onboarding card.
    total_bytes = 0
    days: list[str] = []
    networks: set[str] = set()
    buffers: set[tuple[str, str]] = set()
    channels: set[tuple[str, str]] = set()
    pms: set[tuple[str, str]] = set()
    kind_counts: dict[str, int] = {}
    for e in idx:
        try:
            total_bytes += os.path.getsize(e.path)
        except OSError:
            pass
        if e.day:
            days.append(e.day)
        networks.add(e.network)
        buffers.add((e.network, e.buffer))
        kind = classify_buffer(e.network, e.buffer)
        kind_counts[kind] = kind_counts.get(kind, 0) + 1
        if kind == "channel":
            channels.add((e.network, e.buffer))
        elif kind == "pm":
            pms.add((e.network, e.buffer))
    stats = {
        "total": len(idx),
        "compressed": sum(1 for e in idx if e.compressed),
        "legacy": sum(1 for e in idx if e.day is None),
        "bytes": total_bytes,
        "networks": len(networks),
        "buffers": len(buffers),
        "channels": len(channels),
        "pms": len(pms),
        "oldest": min(days) if days else None,
        "newest": max(days) if days else None,
        "elapsed_ms": int((time.monotonic() - start) * 1000),
        "cache_hit": cache_hit,
        "kinds": kind_counts,
        "logs_dir": str(logs_dir),
    }
    return idx, stats


def humanize_bytes(n: int) -> str:
    # Loop always returns: TB short-circuits the predicate on the
    # final iteration, so no fallback return is needed.
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if n < 1024 or unit == "TB":
            return f"{n:.1f} {unit}" if unit != "B" else f"{n} {unit}"
        n /= 1024
    raise AssertionError("unreachable")


def _index_key(logs_dir: Path) -> str:
    """Hash of (logs_dir path, top-level mtimes). Cheap, detects adds/renames."""
    h = hashlib.sha256()
    h.update(str(logs_dir.resolve()).encode())
    for entry in sorted(os.scandir(logs_dir), key=lambda e: e.name):
        st = entry.stat(follow_symlinks=False)
        h.update(f"{entry.name}:{st.st_mtime_ns}:{st.st_size}\n".encode())
        if entry.is_dir() and YEAR_RE.match(entry.name):
            for sub in sorted(os.scandir(entry.path), key=lambda e: e.name):
                ss = sub.stat(follow_symlinks=False)
                h.update(f"  {sub.name}:{ss.st_mtime_ns}:{ss.st_size}\n".encode())
    return h.hexdigest()


# ---------- query ----------

@dataclass
class Query:
    text: str = ""
    regex: bool = False
    case_sensitive: bool = False
    networks: set[str] = field(default_factory=set)
    buffers: set[tuple[str, str]] = field(default_factory=set)
    date_from: date | None = None
    date_to: date | None = None
    nick: str = ""
    hide_events: bool = True
    include_compressed: bool = False
    # "system" covers meta (core, chanmon, highmon), znc (*status),
    # soju (bouncerserv), and services (ChanServ, NickServ, ...).
    # One mental bucket: "the housekeeping channels that aren't real
    # conversation". Tree scoping still lets you pick one kind.
    include_system: bool = False
    nick_wrap_prefix: str = ""
    nick_wrap_suffix: str = ""


def select_files(index: list[LogFile], q: Query) -> list[str]:
    out: list[str] = []
    for lf in index:
        if lf.compressed and not q.include_compressed:
            continue
        if lf.network.startswith("(") and not q.include_system:
            continue
        kind = classify_buffer(lf.network, lf.buffer)
        if kind in ("znc", "soju", "service") and not q.include_system:
            continue
        if q.networks and lf.network not in q.networks:
            continue
        if q.buffers and (lf.network, lf.buffer) not in q.buffers:
            continue
        if lf.day is not None:
            d = date.fromisoformat(lf.day)
            if q.date_from and d < q.date_from:
                continue
            if q.date_to and d > q.date_to:
                continue
        out.append(lf.path)
    return out


# ---------- ripgrep ----------

EVENT_PREFIXES = {"▬▬▶", "◀▬▬", "-->", "<--", "--"}


@dataclass
class Match:
    path: str
    line_no: int
    timestamp: str
    who: str       # nick for chat, or prefix glyph ("--", "-->", "▬▬▶") for events
    message: str
    is_event: bool


def _match_sort_key(m: "Match") -> tuple:
    """Sort key for result rows. Lexical comparison on raw strings would
    put ISO-T after classic-space at the same instant; parsing fixes
    that. tzinfo is dropped so aware (ISO-Z) and naive (classic) rows
    can be compared in one pass — same-format ordering is exact,
    mixed-format is approximate (off by the local UTC offset)."""
    dt = parse_timestamp(m.timestamp) or datetime.min
    if dt.tzinfo is not None:
        dt = dt.replace(tzinfo=None)
    return (dt, m.path, m.line_no)


def parse_line(raw: str) -> tuple[str, str, str, bool]:
    """Weechat log lines are TSV with 3 fields: ts, who, message.
    Malformed lines (no tabs) return the raw text as the message with
    empty timestamp and nick, so they render as unstructured comments
    rather than polluting the timestamp column."""
    parts = raw.rstrip("\n").split("\t", 2)
    if len(parts) < 2:
        return "", "", parts[0] if parts else "", False
    while len(parts) < 3:
        parts.append("")
    ts, who, msg = parts
    return ts, who, msg, who in EVENT_PREFIXES


# IRC nicks max out around 30 chars even on permissive networks. Cap
# user input so the per-nick subsequence regex stays bounded; a 200-
# char "nick" would otherwise produce 200 `[^\t]*` clauses.
NICK_INPUT_MAX = 32
CHUNK = 10000


async def run_search(q: Query, paths: list[str]):
    if not paths:
        return
    pattern = q.text
    args = ["rg", "--json", "-z", "--no-messages", "-C", "0"]
    if not q.case_sensitive:
        args.append("-S")
    # Accept one or more nicks, comma/space separated. Truncate per
    # nick to bound subseq pattern length.
    nicks = [
        n[:NICK_INPUT_MAX]
        for n in re.split(r"[,\s]+", q.nick.strip())
        if n
    ]
    regex_mode = q.regex or bool(nicks)
    if nicks:
        # Per-nick fzf subsequence; tab anchors prevent body-mention leaks.
        def _subseq(nick: str) -> str:
            # nick is always non-empty here (the `if n` guard filters
            # empties before we reach this point).
            chars = [re.escape(c) for c in nick]
            return "[^\\t]*" + "[^\\t]*".join(chars) + "[^\\t]*"

        nick_alt = "|".join(_subseq(n) for n in nicks)
        # Wrap the subseq with the user's configured nick prefix/suffix
        # so the regex matches what's actually written in the file
        # (e.g. weechat configured with nick_prefix="<" nick_suffix=">"
        # writes the field as `<alice>` between tabs).
        wp = re.escape(q.nick_wrap_prefix)
        ws = re.escape(q.nick_wrap_suffix)
        anchor = rf"\t{wp}({nick_alt}){ws}\t"
        if pattern:
            body = pattern if q.regex else re.escape(pattern)
            pattern = rf"{anchor}.*{body}"
        else:
            pattern = anchor
    elif not pattern:
        # no query at all, nothing to search
        return
    if regex_mode:
        args += ["-e", pattern]
    else:
        args += ["-F", "-e", pattern]

    # rg has no --files-from; pass paths as positional args, chunked to
    # stay well under ARG_MAX (~2 MB on Linux). 10k paths * ~80 chars ≈ 800 KB.
    for i in range(0, len(paths), CHUNK):
        chunk = paths[i:i + CHUNK]
        proc = await asyncio.create_subprocess_exec(
            *args, *chunk,
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.DEVNULL,
        )
        assert proc.stdout
        try:
            async for line in proc.stdout:
                try:
                    obj = json.loads(line)
                except json.JSONDecodeError:
                    # rg occasionally emits a non-JSON progress/banner line
                    # (e.g. on binary-file skips). Drop it and keep reading.
                    continue
                if obj.get("type") != "match":
                    continue
                data = obj["data"]
                path = data["path"]["text"]
                line_no = data["line_number"]
                raw = data["lines"].get("text") or ""
                ts, who, msg, is_event = parse_line(raw)
                if q.hide_events and is_event:
                    continue
                # Post-filter by line timestamp: legacy logs span all dates.
                # Fail-open: unparseable timestamps are included rather
                # than silently dropped, so garbled lines stay visible.
                if q.date_from or q.date_to:
                    d = extract_date(ts)
                    if d is not None and q.date_from and d < q.date_from:
                        continue
                    if d is not None and q.date_to and d > q.date_to:
                        continue
                # Strip configured nick prefix/suffix wrappers so display
                # and downstream filtering see the bare nick.
                if q.nick_wrap_prefix or q.nick_wrap_suffix:
                    who = strip_nick_wrappers(
                        who, q.nick_wrap_prefix, q.nick_wrap_suffix,
                    )
                # Strip WeeChat colour codes if logger.file.color_lines
                # was on when the file was written.
                if "\x19" in msg or "\x1a" in msg or "\x1c" in msg:
                    msg = strip_weechat_colors(msg)
                yield Match(path, line_no, ts, who, msg, is_event)
        finally:
            if proc.returncode is None:
                proc.terminate()
                try:
                    await asyncio.wait_for(proc.wait(), 1.0)
                except TimeoutError:
                    proc.kill()


# ---------- preview ----------

def _plain_context_lines(
    path: str, line_no: int, span: int, hide_events: bool,
) -> list[str]:
    """Plain-text version of the context window, used by 'yank context'.
    Same filtering as the on-screen rendering so what you copy matches
    what you see."""
    lo = max(1, line_no - span)
    hi = line_no + span
    out: list[str] = []
    try:
        with open_log(path) as f:
            for i, ln in enumerate(f, 1):
                if i < lo:
                    continue
                if i > hi:
                    break
                ts, who, msg, is_event = parse_line(ln)
                if hide_events and is_event and i != line_no:
                    continue
                marker = ">>" if i == line_no else "  "
                out.append(f"{marker} {ts}\t{who}\t{msg}")
    except (OSError, EOFError, gzip.BadGzipFile):
        return []
    return out


def read_context(
    path: str,
    line_no: int,
    span: int = 100,
    hide_events: bool = True,
    use_osc8: bool = False,
) -> tuple[Table, int]:
    """Build a Rich Table with coloured nicks, linkified URLs, dim events.

    Renders as a grid so long messages wrap with their indent aligned to
    the start of the message column (Rich Table overflow='fold'),
    instead of spilling back to column 0 on the next line.
    """
    lo = max(1, line_no - span)
    hi = line_no + span
    parsed: list[tuple[bool, bool, str, str, str]] = []
    try:
        with open_log(path) as f:
            for i, ln in enumerate(f, 1):
                if i < lo:
                    continue
                if i > hi:
                    break
                ts, who, msg, is_event = parse_line(ln)
                if hide_events and is_event and i != line_no:
                    continue
                parsed.append((i == line_no, is_event, extract_hms(ts), who or "·", msg))
    except (OSError, EOFError, gzip.BadGzipFile) as e:
        # Preview is advisory: surface the error inline, keep the TUI alive.
        tbl = Table.grid()
        tbl.add_column()
        tbl.add_row(Text(f"(error reading {path}: {e})", style="red"))
        return tbl, 0
    tbl = Table.grid(padding=(0, 1), expand=True)
    tbl.add_column(width=2, no_wrap=True)                  # hit marker
    tbl.add_column(width=8, no_wrap=True)                  # HH:MM:SS
    nick_w = min(20, max((len(w) for _, _, _, w, _ in parsed), default=1))
    tbl.add_column(width=nick_w, no_wrap=True)             # nick
    tbl.add_column(ratio=1, overflow="fold")               # message, wraps
    match_row_index = 0
    for idx, (is_hit, is_event, hms, who, msg) in enumerate(parsed):
        if is_hit:
            match_row_index = idx
        line_style = "dim" if is_event and not is_hit else ""
        marker = Text(">>" if is_hit else "  ",
                      style="bold yellow" if is_hit else line_style)
        time_cell = Text(hms, style=line_style)
        nick_cell = Text(
            who[:nick_w],
            style=(line_style if is_event else nick_color(who)),
        )
        msg_cell = render_message(msg, use_osc8)
        if line_style:
            msg_cell.stylize(line_style)
        tbl.add_row(marker, time_cell, nick_cell, msg_cell)
    return tbl, match_row_index


# ---------- TUI ----------

class Chip(Checkbox):
    BUTTON_LEFT = " "
    BUTTON_INNER = "\u2713"
    BUTTON_RIGHT = " "


class SpanInput(Input):
    """Small Input for the context ± length.

    Shows a muted 'context length' placeholder when empty so the field
    matches the look of the other inputs in the chip row. When the user
    focuses the field, it auto-populates with the app's current span so
    the value is visible and editable rather than re-typed from memory.
    """

    def on_focus(self) -> None:
        if not self.value:
            span = getattr(self.app, "_context_span", 100)
            self.value = str(span)


class ConfirmExport(ModalScreen[bool]):
    CSS = """
    ConfirmExport { align: center middle; }
    #dialog { width: 70; height: auto; padding: 1 2; border: thick $accent;
              background: $surface; }
    #dialog Label { margin-bottom: 1; }
    #buttons { align-horizontal: right; height: 3; margin-top: 1; }
    #buttons Button { margin-left: 2; }
    """
    BINDINGS = [
        Binding("escape", "cancel", "Cancel"),
        Binding("enter", "confirm", "Confirm"),
    ]

    def __init__(self, path: Path, row_count: int) -> None:
        super().__init__()
        self._path = path
        self._rows = row_count

    def compose(self) -> ComposeResult:
        with Vertical(id="dialog"):
            yield Label(
                Text.from_markup(
                    f"Export [b]{self._rows}[/b] rows to\n"
                    f"[b cyan]{self._path}[/b cyan] ?"
                )
            )
            yield Label(
                Text("Note: /tmp is cleared on reboot.", style="dim"),
            )
            with Horizontal(id="buttons"):
                yield Button("Cancel", id="cancel", variant="default")
                yield Button("Export", id="ok", variant="primary")

    def on_mount(self) -> None:
        # Default-focus Export: the action is already gated behind
        # Ctrl+E, so Enter should confirm, not require Tab first.
        self.query_one("#ok", Button).focus()

    @on(Button.Pressed, "#ok")
    def _ok(self) -> None:
        self.dismiss(True)

    @on(Button.Pressed, "#cancel")
    def _cancel(self) -> None:
        self.dismiss(False)

    def action_confirm(self) -> None:
        self.dismiss(True)

    def action_cancel(self) -> None:
        self.dismiss(False)


class ClipboardConsent(ModalScreen[bool]):
    CSS = """
    ClipboardConsent { align: center middle; }
    #dialog { width: 56; height: auto; padding: 1 2; border: thick $accent;
              background: $surface; }
    #buttons { align-horizontal: right; height: 3; margin-top: 1; }
    #buttons Button { margin-left: 2; }
    """
    BINDINGS = [
        Binding("y", "yes", "Yes"),
        Binding("n", "no", "No"),
        Binding("escape", "no", "Cancel"),
    ]

    def compose(self) -> ComposeResult:
        with Vertical(id="dialog"):
            yield Label("Enable clipboard writes (OSC 52) for this session?")
            with Horizontal(id="buttons"):
                yield Button("No", id="cancel", variant="default")
                yield Button("Yes", id="ok", variant="primary")

    @on(Button.Pressed, "#ok")
    def _yes(self) -> None:
        self.dismiss(True)

    @on(Button.Pressed, "#cancel")
    def _no(self) -> None:
        self.dismiss(False)

    def action_yes(self) -> None:
        self.dismiss(True)

    def action_no(self) -> None:
        self.dismiss(False)


