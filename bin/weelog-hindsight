                "[b]F3[/b]        toggle context pane\n"
                "[b]F4[/b]        toggle tree pane\n"
                "[b]Enter[/b]     open match in $PAGER at line\n"
                "[b]y[/b]          yank current row (needs clip chip)\n"
                "[b]Y[/b]          yank focused pane (tree/results/context)\n"
                "[b]Ctrl+E[/b]    export results to /tmp as TSV\n"
                "[b]Ctrl+P[/b]    palette: themes, actions, tree jumps\n"
                "[b]?[/b]          this help\n"
                "[b]Ctrl+Q[/b]    quit\n\n"
                "[b]Scope chips[/b] (what gets searched)\n"
                "  [b]archives[/b]     include rotated .gz / .zst logs\n"
                "  [b]meta[/b]         include core, chanmon, highmon\n"
